# MongoDB port pro klientské připojení (mongos router)
MONGOS_PORT=27017

# Autentizace administrátora clusteru (role root na databázi admin)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=ClusterSuperSecretAdminPassword2026!

# Autentizace aplikace s omezenou rolí (readWrite nad telemedicina + clusterMonitor na admin)
MONGO_APP_USER=telemed_app
MONGO_APP_PASSWORD=AppSecureVitalPass2026!

# Název hlavní databáze
MONGO_DB_NAME=telemedicina
