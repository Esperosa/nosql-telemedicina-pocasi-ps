# ==============================================================================
# Konfigurace prostředí pro Elastic Stack (2. část semestrální práce NoSQL)
# ==============================================================================

# Verze Elastic Stacku (musí být >= 9.2, oficiální pravidlo verzí kurzu)
ELASTIC_VERSION=9.5.2
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.5.2
LOGSTASH_IMAGE=docker.elastic.co/logstash/logstash:9.5.2
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.5.2

# Porty služeb na hostitelském stroji
ES_PORT=9200
KIBANA_PORT=5601

# Hesla uživatelů (nikdy neukládat do Gitu)
ELASTIC_PASSWORD=ElasticSuperSecretAdminPassword2026!
KIBANA_SYSTEM_PASSWORD=KibanaSystemSecurePassword2026!
LOGSTASH_INTERNAL_PASSWORD=LogstashInternalIngestPass2026!

